{
  "name": "reactdevske",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "playwright test",
    "prettier:format": "prettier --write --ignore-path .gitignore .",
    "prettier:check": "prettier --check --ignore-path .gitignore .",
    "typecheck": "tsc --build",
    "validate": "concurrently --kill-others-on-fail -g -p \"[{name}]\" -n \"prettier,lint,typecheck,build\" \"npm:prettier:check -s\" \"npm:lint -s\" \"npm:typecheck -s\" \"npm:build -s -- --no-lint\""
  },
  "pre-commit": [
    "precommit-msg",
    "validate"
  ],
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@types/react-google-recaptcha": "^2.1.9",
    "axios": "^1.8.4",
    "next": "15.2.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-google-recaptcha": "^3.1.0",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@formspree/react": "^3.0.0",
    "@playwright/test": "1.51.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/postcss": "^4.0.17",
    "@types/node": "22.13.14",
    "@types/react": "19.0.12",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "autoprefixer": "10.4.21",
    "concurrently": "^9.1.2",
    "eslint": "9.23.0",
    "eslint-config-next": "15.2.4",
    "eslint-config-prettier": "^10.1.1",
    "postcss": "8.5.3",
    "pre-commit": "^1.2.2",
    "prettier": "^3.5.3",
    "tailwindcss": "4.0.17",
    "typescript": "^5.8.2"
  }
}
